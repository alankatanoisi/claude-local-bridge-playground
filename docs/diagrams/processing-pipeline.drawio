        <mxCell id="v9" value="&lt;b style=&quot;font-size:12px;color:#78350F;&quot;&gt;TERMINAL STOP CONDITION?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Check 25 taxonomy stop reasons&lt;br/&gt;(success, max_steps, budget, bridge_error, etc.)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;arcSize=6;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="860" width="320" height="95" as="geometry" />
        </mxCell>

        <!-- Stage 10: Finalizer -->
        <mxCell id="v10" value="&lt;b style=&quot;font-size:13px;color:#1E1B4B;&quot;&gt;10. IDEMPOTENT RUN FINALIZER (finalizeRun)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4338CA;&quot;&gt;Single terminal exit for all outcomes &amp; process signals (SIGINT / SIGTERM)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;Terminal event → trace flush → transcript flush → run_stopped ledger → autopsy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;arcSize=8;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="990" width="460" height="75" as="geometry" />
