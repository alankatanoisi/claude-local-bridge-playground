<mxfile host="app.diagrams.net" agent="project-documenter">
  <diagram id="processing-pipeline" name="Processing Pipeline">
    <mxGraphModel dx="900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer Boundary Container -->
        <mxCell id="gp" value="RUNNER EXECUTION PIPELINE (src/runner/run.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;fontStyle=1;fontSize=11;fontColor=#475569;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="820" height="1140" as="geometry" />
        </mxCell>

        <!-- Stage 1: Input -->
        <mxCell id="v1" value="&lt;b style=&quot;font-size:12px;color:#134E4A;&quot;&gt;1. INPUT INGESTION&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#0D9488;&quot;&gt;bin/local-bridge-runner.js (parseArgs → run(options))&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;Option parsing, retired profiles validation, defaults resolution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;arcSize=8;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="70" width="460" height="65" as="geometry" />
        </mxCell>

        <!-- Stage 2: Preflight -->
        <mxCell id="v2" value="&lt;b style=&quot;font-size:12px;color:#1E1B4B;&quot;&gt;2. PREFLIGHT &amp; RESUME RECONCILIATION&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4338CA;&quot;&gt;--cwd sanity check  ·  workspace trust gate  ·  session store resume&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;Reconciles checkpoint against *.ledger.jsonl before resuming run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;arcSize=8;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="165" width="460" height="70" as="geometry" />
        </mxCell>

        <!-- Stage 3: Context Build -->
        <mxCell id="v3" value="&lt;b style=&quot;font-size:12px;color:#14532D;&quot;&gt;3. CONTEXT ASSEMBLY &amp; PROJECTION&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#16A34A;&quot;&gt;context-builder.js  ·  context-projection.js&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;System prompt, prompt templates, repo fingerprint, compaction policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="265" width="460" height="70" as="geometry" />
        </mxCell>

        <!-- Stage 4: Model Request -->
        <mxCell id="v4" value="&lt;b style=&quot;font-size:12px;color:#1E1B4B;&quot;&gt;4. MODEL TRANSPORT DISPATCH&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4338CA;&quot;&gt;POST /v1/messages → Claude Local Bridge (:11437)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;model-client.js (buffered/stream), token budget leases, cache-control&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;arcSize=8;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="365" width="460" height="70" as="geometry" />
        </mxCell>

