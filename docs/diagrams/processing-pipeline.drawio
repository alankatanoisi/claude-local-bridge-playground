        <!-- Stage 7: Permission Gate -->
        <mxCell id="v7" value="&lt;b style=&quot;font-size:12px;color:#7F1D1D;&quot;&gt;7. SECURITY &amp; PERMISSION GATE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#DC2626;&quot;&gt;permissions.js  ·  safety.js  ·  authority.js&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;Authority ceiling → resolveFileTarget (realpath confinement) → Allow / Ask / Deny&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;arcSize=8;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="655" width="460" height="70" as="geometry" />
