        <!-- Stage 8: Tool Pipeline -->
        <mxCell id="v8" value="&lt;b style=&quot;font-size:12px;color:#14532D;&quot;&gt;8. TOOL BATCH EXECUTION&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#16A34A;&quot;&gt;tool-pipeline.js  ·  redaction-boundary.js&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;Effect intents/results logged; secret redaction applied; 3-failure streak monitored&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;arcSize=8;align=center;spacing=6;" vertex="1" parent="1">
