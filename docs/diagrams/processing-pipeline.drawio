        <mxCell id="v11" value="&lt;b style=&quot;font-size:12px;color:#78350F;&quot;&gt;ARTIFACT OUTPUTS &amp; RESUME STATE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#D97706;&quot;&gt;~/.bridge-runner (sessions · ledgers · transcripts · traces)  ·  &lt;cwd&gt;/.bridge-runner/runs (undo)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;size=10;align=center;spacing=4;" vertex="1" parent="1">
