          <mxGeometry x="340" y="65" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="planner" value="Planning model call&#xa;&#xa;SEES: objective + manifest&#xa;+ fixed symbolic worker&#xa;+ exact host policy&#xa;&#xa;DOES NOT SEE: provider route" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="host">
