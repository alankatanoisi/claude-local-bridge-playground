        </mxCell>
        <mxCell id="collector" value="Repository collector&#xa;&#xa;Reads only configured roots&#xa;6-file and byte ceilings&#xa;secret paths and symlinks blocked" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="host">
