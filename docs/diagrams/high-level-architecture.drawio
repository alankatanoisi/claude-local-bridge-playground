<mxfile host="app.diagrams.net" agent="project-documenter">
  <diagram id="high-level-architecture" name="High-Level Architecture">
    <mxGraphModel dx="1100" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Local machine container -->
        <mxCell id="g1" value="Local development machine (localhost)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="820" height="640" as="geometry" />
        </mxCell>

        <!-- Left column: local clients -->
        <mxCell id="v1" value="Local Coding-Agent Runner CLI&#10;bin/local-bridge-runner.js&#10;(agent loop: prompt → tool_use → tool_result)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=12;shadow=1;align=center;" vertex="1" parent="1">
