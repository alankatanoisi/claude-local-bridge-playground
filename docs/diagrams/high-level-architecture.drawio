        <mxCell id="v3" value="curl / custom scripts&#10;(Anthropic Messages shape)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1">
