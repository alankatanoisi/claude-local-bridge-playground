        <mxCell id="ye5" value="host.docker.internal:11437" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#7A8FA3;fontSize=10;" edge="1" parent="1" source="y-img" target="y-vs"><mxGeometry relative="1" as="geometry"/></mxCell>
