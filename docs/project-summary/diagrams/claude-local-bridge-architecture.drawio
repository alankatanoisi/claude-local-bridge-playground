        <mxCell id="l10" value="8 · tool_effect_intent (effectId) → execute (path re-checked, backup taken) → tool_effect_result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="240" y="650" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="l11" value="9 · tool_result matched back by tool_use_id, not by completion order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="240" y="740" width="380" height="50" as="geometry"/></mxCell>
        <mxCell id="l12" value="10 · Loop until end_turn, max steps, budget stop, or failure escalation&#10;(3 fully failed batches: foreground asks, non-interactive stops safely)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="240" y="820" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="l13" value="11 · finalizeRun() — one idempotent terminal path&#10;terminal event · trace · transcript flush · run_stopped · autopsy · persist · exit code&#10;SIGINT and SIGTERM route here too" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="200" y="920" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="l14" value="12 · Final answer + [runner usage] token / cost summary on stderr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="240" y="1030" width="380" height="50" as="geometry"/></mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#546E7A;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#546E7A;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#546E7A;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#546E7A;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le7" value="ask" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#7A8FA3;fontSize=10;" edge="1" parent="1" source="l7" target="l8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le8" value="deny" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C62828;fontSize=10;" edge="1" parent="1" source="l7" target="l9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le9" value="allow" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="l7" target="l10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#546E7A;" edge="1" parent="1" source="l10" target="l11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#546E7A;" edge="1" parent="1" source="l11" target="l12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le12" value="next turn" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#7A8FA3;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l12" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
